{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio-lattice.example/schemas/hyperset-hosted-evidence-1.0.json",
  "title": "Folio Lattice Hyperset hosted consumer evidence",
  "description": "Redacted evidence emitted by tests/hyperset_hosted_consumer.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "status",
    "started_at",
    "finished_at",
    "command",
    "deployment",
    "issuer",
    "artifact",
    "assertions",
    "failure",
    "redaction"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gate": {"const": "fl-urj.5.2"},
    "status": {"enum": ["pass", "fail", "blocked"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_a_mcp_url",
        "tenant_b_mcp_url",
        "tenant_a",
        "tenant_b",
        "source_sha",
        "image_digest",
        "revocation_bound_seconds"
      ],
      "properties": {
        "tenant_a_mcp_url": {"type": ["string", "null"]},
        "tenant_b_mcp_url": {"type": ["string", "null"]},
        "tenant_a": {"type": ["string", "null"]},
        "tenant_b": {"type": ["string", "null"]},
        "source_sha": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "minLength": 1},
        "revocation_bound_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "metadata_url", "audience", "metadata_checked", "tokens"],
      "properties": {
        "url": {"type": ["string", "null"]},
        "metadata_url": {"type": ["string", "null"]},
        "audience": {"type": ["string", "null"]},
        "metadata_checked": {"type": "boolean"},
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "tenant", "subject", "algorithm", "key_id", "audience", "fingerprint"],
            "properties": {
              "profile": {"enum": ["A_OWNER", "A_MEMBER", "B"]},
              "tenant": {"type": "string", "minLength": 1},
              "subject": {"type": "string", "minLength": 1},
              "algorithm": {"type": "string", "minLength": 1},
              "key_id": {"type": "string", "minLength": 1},
              "audience": {"type": "array", "items": {"type": "string"}},
              "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{16}$"}
            }
          }
        }
      }
    },
    "artifact": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "target_artifact_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "initial_version_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1},
        "initial_blob_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "blob_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "details"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "details": {"type": "object"}
        }
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "cookies", "private_keys", "content_bytes", "command_output"],
      "properties": {
        "tokens": {"const": "excluded"},
        "cookies": {"const": "excluded"},
        "private_keys": {"const": "excluded"},
        "content_bytes": {"const": "excluded; SHA-256 only"},
        "command_output": {"const": "excluded"}
      }
    }
  }
}

