# Local Docker development only. Copy to `.env` before `make docker-up`.
# Never use these defaults for hosted deployments or shared environments.

# Compose-native project name. Keep FOLIO_COMPOSE_PROJECT aligned for Make.
COMPOSE_PROJECT_NAME=folio-lattice-local
FOLIO_COMPOSE_PROJECT=folio-lattice-local
FOLIO_RENDERER_CAPABILITY_SECRET=local-only-renderer-capability-secret-0123456789abcdef0123456789
FOLIO_HOST_PORT=8000
FOLIO_RENDER_HOST_PORT=8001
